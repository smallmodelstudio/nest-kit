{
  "name": "nest-kit",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter=./packages/** run build",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "pnpm --filter=./packages/** run typecheck",
    "test": "vitest run",
    "check:exports": "pnpm --filter=./packages/** exec publint && pnpm --filter=./packages/** exec attw --pack .",
    "check:layers": "depcruise packages --config .dependency-cruiser.cjs",
    "check:standalone": "node scripts/standalone-check.mjs",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run check:layers",
    "changeset": "changeset"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@swc/core": "^1.16.2",
    "@vitest/coverage-v8": "^5.0.1",
    "dependency-cruiser": "^18.3.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.0.1"
  }
}
