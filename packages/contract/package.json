{
  "name": "@smallmodelstudio/contract",
  "version": "0.0.0",
  "description": "Define a resource once in Zod and get validation, types and OpenAPI docs from it.",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
