{
  "name": "@smallmodelstudio/nest-config",
  "version": "0.0.0",
  "description": "ConfigKitModule.forRoot({ schema }): env vars parsed and shaped by one Zod schema, provided for injection with @InjectConfig().",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@nestjs/common": "^12",
    "zod": "^4"
  },
  "devDependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/testing": "^12.0.3",
    "@types/node": "24.13.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  }
}
