{
  "name": "@smallmodelstudio/nest-http",
  "version": "0.0.0",
  "description": "Nest wrapper around http-client: config-driven base URL, timeout and retries, retry metrics, and x-correlation-id forwarding.",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@smallmodelstudio/http-client": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^12",
    "@opentelemetry/api": "^1.9"
  },
  "devDependencies": {
    "@nestjs/common": "^12.0.3",
    "@opentelemetry/api": "^1.9.1",
    "@types/node": "24.13.4",
    "reflect-metadata": "^0.2.2"
  }
}
