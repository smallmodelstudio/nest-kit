{
  "name": "@smallmodelstudio/nest-metrics",
  "version": "0.0.0",
  "description": "Typed counters and histograms over the OpenTelemetry API, plus a request-rate/error/duration interceptor per route.",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@nestjs/common": "^12",
    "@opentelemetry/api": "^1.9",
    "fastify": "^5",
    "rxjs": "^7"
  },
  "devDependencies": {
    "@nestjs/common": "^12.0.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@types/node": "24.13.4",
    "fastify": "^5.12.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
