  "devDependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-fastify": "^12.0.3",
    "@nestjs/testing": "^12.0.3",
    "@types/node": "24.13.4",
    "@types/supertest": "^7.0.0",
    "fastify": "^5.12.3",
